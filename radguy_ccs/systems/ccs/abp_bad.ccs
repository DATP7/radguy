                  dsend_0, dsend_1, dack_0, dack_1 };
agent ABPl_4 = (Send_0|Receive_0 | (Buffer4LBad [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer4L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
