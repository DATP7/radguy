

Send_0 = accept.Send_out_0;
Send_1 = accept.Send_out_1;

Send_out_0 = 'send_0.Send_wait_0;
Send_out_1 = 'send_1.Send_wait_1;

Send_wait_0 = Send_out_0 + dack_0.Send_1 + dack_1.Send_wait_0;
Send_wait_1 = Send_out_1 + dack_1.Send_0 + dack_0.Send_wait_1;

***  Receive 

Receive_0 = dsend_0.Receive_ack_0 + dsend_1.'ack_1.Receive_0;
Receive_1 = dsend_1.Receive_ack_1 + dsend_0.'ack_0.Receive_1;

Receive_ack_0 = 'deliver.'ack_0.Receive_1;
Receive_ack_1 = 'deliver.'ack_1.Receive_0;

*** Medium (perfect)

Medium_send = send_0.'dsend_0.Medium_send + send_1.'dsend_1.Medium_send;
Medium_ack = ack_0.'dack_0.Medium_ack + ack_1.'dack_1.Medium_ack;

*** Medium (lossy)

Mediuml_send = send_0.Mediuml_send_0 + send_1.Mediuml_send_1;
Mediuml_send_0 = 'dsend_0.Mediuml_send + Mediuml_send;
Mediuml_send_1 = 'dsend_1.Mediuml_send + Mediuml_send;

Mediuml_ack = ack_0.Mediuml_ack_0 + ack_1.Mediuml_ack_1;
Mediuml_ack_0 = 'dack_0.Mediuml_ack + Mediuml_ack;
Mediuml_ack_1 = 'dack_1.Mediuml_ack + Mediuml_ack;

****** ------------- Buffered version of lossy and not lossy medium ----------------
* Buffer - perfect
* BufferL - lossy, may drop any bit, at any place, at any time.
*   not entirely as original, since they require synchronization in order to drop or not.
Medium_send_B = Buffer1 [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1];
Medium_ack_B = Buffer1 [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1];
Mediuml_send_B = Buffer1L [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1];
Mediuml_ack_B = Buffer1L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1];


SPEC = accept.'deliver.SPEC;
ABP = (Send_0|Receive_0|Medium_send_B|Medium_ack_B) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABPl = (Send_0|Receive_0|Mediuml_send_B|Mediuml_ack_B) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };

******** Sequential buffer

* Perfect
Buffer1 = in_0.'out_0.Buffer1 + in_1.'out_1.Buffer1;
Buffer2 = ((Buffer1 [shift_0/out_0, shift_1/out_1]) | (Buffer1 [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer3 = ((Buffer1 [shift_0/out_0, shift_1/out_1]) | (Buffer2 [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer4 = ((Buffer2 [shift_0/out_0, shift_1/out_1]) | (Buffer2 [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer5 = ((Buffer2 [shift_0/out_0, shift_1/out_1]) | (Buffer3 [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer6 = ((Buffer4 [shift_0/out_0, shift_1/out_1]) | (Buffer2 [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer8 = ((Buffer4 [shift_0/out_0, shift_1/out_1]) | (Buffer4 [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};

* Lossy
Buffer1L = in_0.('out_0.Buffer1L + tau.Buffer1L) + in_1.('out_1.Buffer1L + tau.Buffer1L);
Buffer2L = ((Buffer1L [shift_0/out_0, shift_1/out_1]) | (Buffer1L [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer3L = ((Buffer1L [shift_0/out_0, shift_1/out_1]) | (Buffer2L [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer4L = ((Buffer2L [shift_0/out_0, shift_1/out_1]) | (Buffer2L [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer5L = ((Buffer2L [shift_0/out_0, shift_1/out_1]) | (Buffer3L [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer6L = ((Buffer4L [shift_0/out_0, shift_1/out_1]) | (Buffer2L [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};
Buffer8L = ((Buffer4L [shift_0/out_0, shift_1/out_1]) | (Buffer4L [shift_0/in_0, shift_1/in_1])) \ {shift_0, shift_1};

******** Buffers end


* Convenience

ABP_2 = (Send_0|Receive_0 | (Buffer2 [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer2 [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABP_3 = (Send_0|Receive_0 | (Buffer3 [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer3 [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABP_4 = (Send_0|Receive_0 | (Buffer4 [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer4 [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABP_5 = (Send_0|Receive_0 | (Buffer5 [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer5 [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABP_6 = (Send_0|Receive_0 | (Buffer6 [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer6 [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };

ABPl_2 = (Send_0|Receive_0 | (Buffer2L [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer2L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABPl_3 = (Send_0|Receive_0 | (Buffer3L [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer3L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABPl_4 = (Send_0|Receive_0 | (Buffer4L [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer4L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABPl_5 = (Send_0|Receive_0 | (Buffer5L [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer5L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };
ABPl_6 = (Send_0|Receive_0 | (Buffer6L [send_0/in_0, dsend_0/out_0, send_1/in_1, dsend_1/out_1]) | (Buffer6L [ack_0/in_0, dack_0/out_0, ack_1/in_1, dack_1/out_1])) \ { send_0, send_1, ack_0, ack_1, 
                  dsend_0, dsend_1, dack_0, dack_1 };

