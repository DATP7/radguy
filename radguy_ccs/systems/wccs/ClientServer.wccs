# Client/Server set-up
System := ClientA | ClientB | Server \ {request};

# Requests data and unpacks response
ClientA := Client | Client;
ClientB := Client;
Client := <request!,1>.<response,2>.(failed:<timeout,0>.Client + DeliverData);

#Deliver the data package
DeliverData := <unpack,5>.<deliver,0>.delivered:Client;

# Server responds or fails
Server := <request,3>.Response + congested:<timeout!,0>.Server;

#Send response to client
Response := <response!,5>.Server;