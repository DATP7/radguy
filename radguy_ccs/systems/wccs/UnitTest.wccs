# Simple communication
Communication :=(ready:0 | ready:done:<a!>.done:0);

Nil := 0;

# Restriction of action
Restriction := (<b>.bad:0) \ {b};

P1 := l1:<a>.(l2:Nil + l3:Nil); 
P2 := (l1:<c>.(l3:0 | (l2:Nil | l3:Nil))) \ {b} \ {a}; 


# Communication under restriction
RestrictedCommunication := (<a,2>.done:(Nil + Nil) | <a!,3>.done:0);

# Rename a property
RenameProperty := (maybe:maybe:<a>.maybe:(P1 | (P2 + P1))) [maybe => okay];

# Simple communication
RenamedCommunication := ((ready:<b>.done:0) [b -> a] + ready:okay:<a!>.done:0) \ {b,a};

# Refernece a process constant
ProcessConstant := <a>.RenameProperty;

# Choice between two processes
Choice := <a>.did_a:0 + <b>.did_b:0;

# Two parallel processes
Parallel := <a>.did_a:0 | <b>.did_b:0;

# Bounded action prefix
Action := <a,10>.done:0;

# Check that replication works
Replication := <a>.Replication + <b>.done:0;
